# 이 파일은 git에 커밋된다. 실제 값은 .env 에만 넣을 것.
# 새 환경(Render/Railway 등)을 세팅할 때 필요한 변수 목록 역할을 한다.

# ─────────────────────────────────────────────────────────────
# Supabase — 배치가 congestion_forecast 에 쓰기 때문에 RLS를 우회하는 키가 필요하다.
# 대시보드 → API Keys → "Publishable and secret API keys" → Secret keys (sb_secret_...)
# 레거시 service_role JWT 대신 신형 secret key를 쓴다. 신형은 브라우저에서
# 호출하면 401로 거부돼, 키가 새더라도 클라이언트에서는 무력하다.
# 절대 Next.js나 브라우저로 넘기지 말 것.
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://nqnxvhvozzstzloymovr.supabase.co
SUPABASE_SECRET_KEY=

# ─────────────────────────────────────────────────────────────
# 한국관광공사 TourAPI 인증키 (data.go.kr 발급, Decoding 키를 쓴다)
# 장소 목록·상세정보·집중률 예측을 모두 이 키 하나로 호출한다.
# 비워두면 mock 데이터로 동작한다.
# ─────────────────────────────────────────────────────────────
KTO_API_KEY=

# ─────────────────────────────────────────────────────────────
# 날씨 — 아래 셋 중 채워진 것을 위에서부터 골라 쓴다.
# 하나도 없으면 키가 필요 없는 Open-Meteo 로 동작하므로 비워둬도 된다.
# ─────────────────────────────────────────────────────────────

# ① 기상청 단기예보 (data.go.kr). 국내 예보의 원본이라 정확도가 가장 높다.
#    KTO_API_KEY 와 같은 data.go.kr 인증키가 그대로 먹는다 —
#    "기상청_단기예보 조회서비스" 활용신청만 하면 된다.
KMA_API_KEY=

# ② OpenWeatherMap. 무료 키는 3시간 간격 forecast(2.5)를 쓴다.
#    One Call 3.0 은 결제수단 등록이 필요해 쓰지 않는다.
OPENWEATHER_API_KEY=

# ⚠️ WEATHER_API_KEY 라는 이름은 쓰지 않는다. 제공자를 구분할 수 없어서
#    OpenWeatherMap 키를 기상청으로 호출해 403 을 받는 사고가 있었다.
