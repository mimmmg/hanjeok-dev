# 이 파일은 git에 커밋된다. 실제 값은 .env 에만 넣을 것.

# Supabase — 배치가 congestion_forecast에 쓰기 때문에 RLS를 우회하는 키가 필요하다.
# 대시보드 → API Keys → "Publishable and secret API keys" → Secret keys (sb_secret_...)
# 레거시 service_role JWT 대신 신형 secret key를 쓴다. 신형은 브라우저에서
# 호출하면 401로 거부돼, 키가 새더라도 클라이언트에서는 무력하다.
# 절대 Next.js나 브라우저로 넘기지 말 것.
SUPABASE_URL=https://nqnxvhvozzstzloymovr.supabase.co
SUPABASE_SECRET_KEY=

# 한국관광공사 TourAPI 인증키 (data.go.kr 에서 발급, Decoding 키를 쓴다)
# 비워두면 mock 장소 데이터로 동작한다.
KTO_API_KEY=

# 기상청 단기예보 인증키. 비워두면 맑음 고정 곡선으로 동작한다.
WEATHER_API_KEY=
