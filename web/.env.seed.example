# 시드 스크립트 전용 환경변수. 복사해서 .env.seed 로 만들고 값을 채운다.
#
# .env.local 과 분리한 이유:
# service_role 키는 RLS 를 통째로 우회하는 마스터 키다. Next.js 앱이 읽는
# 파일에 두면 앱 코드에서 실수로 쓰거나 Vercel 환경변수로 올라갈 수 있다.
# 시드는 사람이 손으로 돌리는 도구라, 실행할 때만 --env-file 로 따로 읽는다.

SUPABASE_URL=https://nqnxvhvozzstzloymovr.supabase.co

# 대시보드 → Settings → API Keys → "Publishable and secret API keys" 탭
#   → Secret keys 의 sb_secret_... 값
#
# 같은 화면의 레거시 service_role JWT(eyJ...)도 동작하지만 신형을 쓴다.
# 신형 secret key 는 브라우저에서 호출하면 User-Agent 를 보고 401 로 거부한다.
# 이 프로젝트에서 가장 위험한 사고가 "RLS 우회 키가 클라이언트로 새는 것"인데,
# 신형은 새더라도 키 자체가 거부한다. 레거시 JWT 는 그냥 동작해버린다.
#
# 절대 브라우저로 넘기거나 커밋하지 말 것.
SUPABASE_SECRET_KEY=
